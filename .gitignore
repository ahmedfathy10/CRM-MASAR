# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/pnpm-lock.yaml
/.pnpm-store/

# Local CRM data and deployment artifacts must never be committed.
/.deploy/
/.codex-tmp/
/.tmp_*/
/.site-stage-*/
/site-v*.tar.gz
/backups/
/*.log
/*.sqlite
/*.sqlite3
/*.db

# Local launch and diagnostic output.
/.app-server*.log
/.dev-server*.log
/.local-dev*.log
/.codex-dev.log
